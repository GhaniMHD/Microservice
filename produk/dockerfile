# Step 1: Use an official lightweight Java 17 runtime environment
FROM eclipse-temurin:17-jdk-alpine

# Step 2: Set the working directory inside the container to /app
WORKDIR /app

# Step 3: Copy the compiled .jar file from your local target folder into the container
COPY target/*.jar app.jar

# Step 4: Inform Docker that the container listens on port 8081 at runtime
EXPOSE 8081

# Step 5: The command to run your Spring Boot application
ENTRYPOINT ["java", "-jar", "app.jar"]